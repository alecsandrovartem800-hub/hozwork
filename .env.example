# ============================================
# HOZWORK — Environment Variables Template
# ============================================
# Copy this file to .env.local (frontend) or .env (backend)
# and fill in real values.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- Backend API ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Payment Gateway (plug in later) ---
# 🔑 INSERT_YOUR_PAYMENT_GATEWAY_KEY_HERE
PAYMENT_GATEWAY_KEY=mock

# --- Email Service (plug in later) ---
# 🔑 INSERT_YOUR_EMAIL_SERVICE_KEY_HERE
EMAIL_SERVICE_KEY=mock

# --- Analytics (plug in later) ---
# 🔑 INSERT_YOUR_ANALYTICS_KEY_HERE
ANALYTICS_KEY=mock
